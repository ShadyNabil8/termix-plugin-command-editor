{
  "name": "termix-plugin-command-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "termix-plugin build",
    "test": "termix-plugin test",
    "typecheck": "tsc -p .",
    "validate": "termix-plugin validate",
    "pack": "termix-plugin pack",
    "sign": "termix-plugin sign",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@termix-ssh/plugin-sdk": "^1.0.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.9",
    "react-i18next": "^17.0.16",
    "sonner": "^2.0.8",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@termix-ssh/plugin-sdk": "^1.0.5",
    "react": "^19.2.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.65.0"
  }
}
